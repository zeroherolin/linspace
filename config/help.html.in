<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>@@TITLE@@ · @@SITE_NAME@@</title>
<style>
:root {
  --bg: #fcfcfc;
  --fg: #1c1c1e;
  --muted: #6e6e73;
  --faint: #a1a1a6;
  --rule: #e6e6e8;
  --code-bg: #f1f1f2;
  --pre-bg: #f6f6f7;
  --pre-fg: #2c2c2e;
  --accent: #1d4ed8;
  --c: #9a9aa0;
  --s: #7c5a2b;
  --v: #3b6ea8;
  --k: #1c1c1e;
  --o: #a1a1a6;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111113;
    --fg: #ececee;
    --muted: #9a9aa0;
    --faint: #6b6b71;
    --rule: #26262a;
    --code-bg: #1e1e22;
    --pre-bg: #17171a;
    --pre-fg: #dcdce0;
    --accent: #7aa2ff;
    --c: #6b6b71;
    --s: #c9a97a;
    --v: #8fb6ea;
    --k: #f2f2f4;
    --o: #6b6b71;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--fg);
  font: 15px/1.7 var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
main, footer {
  width: 100%;
  max-width: 46rem;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}
main { flex: 1; padding-top: 4.5rem; padding-bottom: 4rem; }
h1 {
  margin: 0 0 0.75rem;
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
}
h1 + p { margin: 0 0 3rem; color: var(--muted); }
h2 {
  margin: 3rem 0 1rem;
  font-size: 1.05rem;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
}
h3 { margin: 1.75rem 0 0.75rem; font-size: 0.95rem; font-weight: 600; }
p, ul, ol { margin: 0 0 1rem; }
ul, ol { padding-left: 1.25rem; }
li { margin: 0.2rem 0; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
code {
  padding: 0.12em 0.4em;
  border-radius: 5px;
  background: var(--code-bg);
  font: 0.86em var(--mono);
}
pre {
  position: relative;
  overflow-x: auto;
  margin: 0 0 1.5rem;
  padding: 1.5rem 1.5rem 1.4rem;
  border: 1px solid var(--rule);
  border-radius: 10px;
  background: var(--pre-bg);
  color: var(--pre-fg);
  tab-size: 4;
}
pre::before {
  content: attr(data-language);
  position: absolute;
  top: 0.8rem;
  right: 1.1rem;
  color: var(--faint);
  font: 500 0.62rem/1 var(--mono);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
pre code {
  display: block;
  padding: 0;
  border-radius: 0;
  background: none;
  font-size: 0.82rem;
  line-height: 1.75;
  white-space: pre;
}
pre .c { color: var(--c); }
pre .s { color: var(--s); }
pre .v { color: var(--v); }
pre .k { color: var(--k); font-weight: 500; }
pre .o { color: var(--o); }
footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  padding-top: 1.5rem;
  padding-bottom: 3rem;
  border-top: 1px solid var(--rule);
  color: var(--faint);
  font-size: 0.8rem;
}
footer a { color: var(--muted); }
@media (max-width: 640px) {
  body { font-size: 14.5px; }
  main, footer { padding-left: 1.25rem; padding-right: 1.25rem; }
  main { padding-top: 3rem; padding-bottom: 3rem; }
  footer { padding-top: 1.25rem; padding-bottom: 2.5rem; }
  h1 { font-size: 1.55rem; }
  h1 + p { margin-bottom: 2.25rem; }
  h2 { margin-top: 2.25rem; }
  pre { padding: 1.35rem 1.1rem 1.25rem; border-radius: 8px; }
  pre code { font-size: 0.78rem; }
}
</style>
</head>
<body>
<main>
@@BODY@@
</main>
<footer>
  <a href="/">@@SITE_NAME@@</a>
  <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">@@ICP_NUMBER@@</a>
</footer>
</body>
</html>
