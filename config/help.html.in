<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>@@TITLE@@ · @@SITE_NAME@@</title>
<style>
:root {
  --bg: #ffffff;
  --fg: #1f2329;
  --muted: #646a73;
  --faint: #8f959e;
  --rule: #e2e4e8;
  --code-bg: #f2f3f5;
  --pre-bg: #f5f6f7;
  --pre-fg: #1f2329;
  --accent: #3370ff;
  --c: #8f959e;
  --s: #2ea121;
  --k: #d9760c;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  --mono: Menlo, "SF Mono", ui-monospace, Consolas, "Liberation Mono", "DejaVu Sans Mono", monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1a1a1a;
    --fg: #ebebeb;
    --muted: #a6a6a6;
    --faint: #757575;
    --rule: #333333;
    --code-bg: #2a2a2a;
    --pre-bg: #232323;
    --pre-fg: #e3e3e3;
    --accent: #4c88ff;
    --c: #7a7a7a;
    --s: #62c554;
    --k: #f0a04a;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--fg);
  font: 15px/1.75 var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
main, footer {
  width: 100%;
  max-width: 56rem;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}
main { flex: 1; padding-top: 4rem; padding-bottom: 4rem; }
h1 {
  margin: 0 0 0.75rem;
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
}
h1 + p { margin: 0 0 2.5rem; color: var(--muted); }
h2 {
  margin: 2.5rem 0 0.875rem;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.35;
}
h3 { margin: 1.5rem 0 0.625rem; font-size: 1.05rem; font-weight: 600; }
p, ul, ol { margin: 0 0 1rem; }
ul, ol { padding-left: 1.5rem; }
li { margin: 0.25rem 0; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
code {
  padding: 0.1em 0.4em;
  border-radius: 4px;
  background: var(--code-bg);
  font: 0.875em var(--mono);
}
pre {
  position: relative;
  overflow-x: auto;
  margin: 0 0 1.5rem;
  padding: 2.5rem 1.25rem 1.2rem;
  border: 1px solid var(--rule);
  border-radius: 8px;
  background: var(--pre-bg);
  color: var(--pre-fg);
  tab-size: 4;
  counter-reset: line;
}
pre::before {
  content: attr(data-language);
  position: absolute;
  top: 0.85rem;
  right: 1.25rem;
  color: var(--muted);
  font: 400 0.8rem/1 var(--sans);
  text-transform: capitalize;
}
pre code {
  display: block;
  padding: 0;
  border-radius: 0;
  background: none;
  font-size: 0.875rem;
  line-height: 1.85;
  white-space: pre;
}
pre .line { display: block; }
pre .line::before {
  content: counter(line);
  counter-increment: line;
  display: inline-block;
  width: 1.75rem;
  margin-right: 1.25rem;
  color: var(--faint);
  font-size: 0.9em;
  text-align: right;
  user-select: none;
  -webkit-user-select: none;
}
pre .c { color: var(--c); font-style: italic; }
pre .s { color: var(--s); }
pre .k { color: var(--k); }
footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  padding-top: 1.5rem;
  padding-bottom: 3rem;
  border-top: 1px solid var(--rule);
  color: var(--faint);
  font-size: 0.875rem;
}
footer a { color: var(--muted); }
@media (max-width: 720px) {
  body { font-size: 14.5px; }
  main, footer { padding-left: 1.25rem; padding-right: 1.25rem; }
  main { padding-top: 2.5rem; padding-bottom: 3rem; }
  footer { padding-top: 1.25rem; padding-bottom: 2.5rem; }
  h1 { font-size: 1.5rem; }
  h1 + p { margin-bottom: 1.75rem; }
  h2 { margin-top: 2rem; font-size: 1.15rem; }
  pre { padding: 2.4rem 0.9rem 1rem; border-radius: 6px; }
  pre::before { right: 0.9rem; top: 0.8rem; font-size: 0.75rem; }
  pre code { font-size: 0.8rem; line-height: 1.8; }
  pre .line::before { width: 1.5rem; margin-right: 0.9rem; }
}
</style>
</head>
<body>
<main>
@@BODY@@
</main>
<footer>
  <a href="/">@@SITE_NAME@@</a>
  <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener">@@ICP_NUMBER@@</a>
</footer>
</body>
</html>
