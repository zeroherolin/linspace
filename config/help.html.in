<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>@@TITLE@@ · @@SITE_NAME@@</title>
<style>
:root {
  --bg: #ffffff;
  --fg: #1f2329;
  --muted: #646a73;
  --faint: #8f959e;
  --rule: #e2e4e8;
  --code-bg: #f2f3f5;
  --pre-bg: #f5f6f7;
  --pre-fg: #1f2329;
  --accent: #3370ff;
  --c: #646a73;
  --s: #2ea121;
  --k: #d9760c;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  --mono: Menlo, "SF Mono", ui-monospace, Consolas, "Liberation Mono", "DejaVu Sans Mono", monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #1a1a1a;
    --fg: #ebebeb;
    --muted: #a6a6a6;
    --faint: #757575;
    --rule: #333333;
    --code-bg: #2a2a2a;
    --pre-bg: #232323;
    --pre-fg: #e3e3e3;
    --accent: #4c88ff;
    --c: #a6a6a6;
    --s: #62c554;
    --k: #f0a04a;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--fg);
  font: 15px/1.75 var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
main, footer {
  width: 100%;
  max-width: 56rem;
  margin: 0 auto;
  padding-left: 2rem;
  padding-right: 2rem;
}
main { flex: 1; padding-top: 3.25rem; padding-bottom: 3.5rem; }
h1 {
  margin: 0 0 0.75rem;
  font-size: 1.75rem;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: -0.01em;
}
h1 + p { margin: 0 0 2.5rem; color: var(--muted); }
h2 {
  margin: 2.5rem 0 0.875rem;
  font-size: 1.25rem;
  font-weight: 600;
  line-height: 1.35;
}
h3 { margin: 1.5rem 0 0.625rem; font-size: 1.05rem; font-weight: 600; }
p, ul, ol { margin: 0 0 1rem; }
p { overflow-wrap: anywhere; }
ul, ol { padding-left: 1.5rem; }
li { margin: 0.25rem 0; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; text-underline-offset: 0.15em; }
a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
main > p { max-width: 48rem; }
code {
  padding: 0.1em 0.4em;
  border-radius: 4px;
  background: var(--code-bg);
  font: 0.875em var(--mono);
}
pre {
  position: relative;
  overflow: hidden;
  margin: 0 0 1.5rem;
  border: 1px solid var(--rule);
  border-radius: 8px;
  background: var(--pre-bg);
  color: var(--pre-fg);
  tab-size: 4;
  counter-reset: line;
}
pre::before {
  content: attr(data-language);
  position: absolute;
  z-index: 1;
  top: 0.85rem;
  right: 1.25rem;
  color: var(--muted);
  font: 400 0.8rem/1 var(--sans);
  text-transform: capitalize;
}
/* The code element scrolls; the frame, label and line numbers stay put. The single
   grid column is sized by the longest line, so every line spans the full scroll
   width and its sticky gutter always has a box to stick inside. Padding on the
   column's right is real scrollable width, so text stops short of the frame. */
pre code {
  display: grid;
  grid-template-columns: max-content;
  overflow-x: auto;
  padding: 2.5rem 0 1.2rem;
  border-radius: 0;
  background: none;
  font-size: 0.875rem;
  line-height: 1.85;
  white-space: pre;
}
pre .line {
  display: block;
  padding-right: 2rem;
}
/* The gutter sticks to the scrollport and paints over text passing beneath it. */
pre .line::before {
  content: counter(line);
  counter-increment: line;
  position: -webkit-sticky;
  position: sticky;
  left: 0;
  display: inline-block;
  width: 1.75rem;
  padding: 0 1.25rem;
  background: var(--pre-bg);
  color: var(--faint);
  font-size: 0.9em;
  text-align: right;
  user-select: none;
  -webkit-user-select: none;
}
pre .c { color: var(--c); font-style: italic; }
pre .s { color: var(--s); }
pre .k { color: var(--k); }
footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  padding-top: 1.5rem;
  padding-bottom: 3rem;
  border-top: 1px solid var(--rule);
  color: var(--faint);
  font-size: 0.875rem;
}
footer a { color: var(--muted); }
@media (max-width: 720px) {
  body { font-size: 14.5px; }
  main, footer { padding-left: 1.25rem; padding-right: 1.25rem; }
  main { padding-top: 2.25rem; padding-bottom: 2.75rem; }
  footer { padding-top: 1.25rem; padding-bottom: 2.5rem; }
  h1 { font-size: 1.5rem; }
  h1 + p { margin-bottom: 1.75rem; }
  h2 { margin-top: 2rem; font-size: 1.15rem; }
  pre { border-radius: 6px; }
  pre::before { right: 0.9rem; top: 0.8rem; font-size: 0.75rem; }
  pre code { padding: 2.4rem 0 1rem; font-size: 0.8rem; line-height: 1.8; }
  pre .line { padding-right: 1.5rem; }
  pre .line::before { width: 1.5rem; padding: 0 0.9rem; }
}
</style>
</head>
<body>
<main>
@@BODY@@
</main>
<footer>
@@FOOTER@@
</footer>
</body>
</html>
