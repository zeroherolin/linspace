@@DOMAIN@@ {
    root * /srv/linspace/current
    header X-Content-Type-Options "nosniff"
    import /etc/caddy/linspace.d/stash.caddy

    @home path /
    handle @home {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "no-store"
        file_server
    }
    @text path@@SSH_ROUTE@@ /mihomo/install /mihomo/sub /mihomo/restart /claude/install /claude/config /codex/install /codex/config /codex/models_1m /codex/auth
    handle @text {
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "no-store"
        file_server
    }
    handle {
        respond "Not found" 404
    }
}
