# linspace stash - HTTPS transport; stashd verifies SSH signatures on every write.
rewrite /stash/upload /stash/upload0
rewrite /stash/download /stash/download0

@stash_scripts {
    method GET HEAD
    path_regexp ^/stash/(upload[0-7]|clear|keys)$
}
handle @stash_scripts {
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

@stash_read {
    method GET HEAD
    path_regexp ^/stash/download[0-7]$
}
handle @stash_read {
    uri strip_prefix /stash
    root * /var/lib/stashd
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

# Text channels stay small; a published page is one HTML file that may inline its images.
@stash_text path_regexp ^/stash/(challenge|download[0-7]|clear)$
request_body @stash_text {
    max_size 1MiB
}
@stash_page path_regexp ^/stash/page/[a-z0-9][a-z0-9_-]{0,47}$
request_body @stash_page {
    max_size 4MiB
}

@stash_api {
    path_regexp ^/stash/(challenge|download[0-7]|clear|page/[a-z0-9][a-z0-9_-]{0,47})$
}
handle @stash_api {
    reverse_proxy unix//run/stashd/ssh.sock {
        header_up -Authorization
        # The site block already sets this header; avoid emitting it twice.
        header_down -X-Content-Type-Options
        # stashd answers one request per connection and closes; never reuse an idle
        # upstream connection for a PUT/POST that cannot be retried.
        transport http {
            keepalive off
            response_header_timeout 30s
        }
    }
}
