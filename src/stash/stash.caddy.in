# linspace stash - generated by linspace; deploy with --rotate-token for explicit token rotation.
rewrite /stash/upload /stash/upload0
rewrite /stash/download /stash/download0

@stash_scripts {
    method GET HEAD
    path_regexp ^/stash/(upload[0-7]|clear)$
}
handle @stash_scripts {
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

@stash_read {
    method GET HEAD
    path_regexp ^/stash/download[0-7]$
}
handle @stash_read {
    uri strip_prefix /stash
    root * /var/lib/stashd
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

@stash_write {
    method PUT POST
    path_regexp ^/stash/(download[0-7]|clear)$
}
basic_auth @stash_write bcrypt "linspace stash" {
    stash __HASH__
}
handle @stash_write {
    request_body {
        max_size 1MiB
    }
    reverse_proxy unix//run/stashd/stashd.sock
}
