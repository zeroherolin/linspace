# linspace stash - HTTPS transport; stashd verifies SSH signatures on every write.
rewrite /stash/upload /stash/upload0
rewrite /stash/download /stash/download0

@stash_scripts {
    method GET HEAD
    path_regexp ^/stash/(upload[0-7]|clear|keys)$
}
handle @stash_scripts {
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

@stash_read {
    method GET HEAD
    path_regexp ^/stash/download[0-7]$
}
handle @stash_read {
    uri strip_prefix /stash
    root * /var/lib/stashd
    header Content-Type "text/plain; charset=utf-8"
    header Cache-Control "no-store"
    file_server
}

@stash_api {
    path_regexp ^/stash/(challenge|download[0-7]|clear)$
}
handle @stash_api {
    request_body {
        max_size 1MiB
    }
    reverse_proxy unix//run/stashd/ssh.sock {
        header_up -Authorization
    }
}
