[Unit]
Description=stashd - write side of linspace stash
Requires=stashd.socket
After=stashd.socket

[Service]
Type=simple
User=stash
Group=stash
ExecStart=/usr/bin/python3 /usr/local/lib/stashd/stashd.py --domain @@DOMAIN@@ --allowed-signers /usr/local/lib/stashd/allowed_signers
StateDirectory=stashd
StateDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
