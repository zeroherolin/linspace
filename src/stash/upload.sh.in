#!/usr/bin/env bash
# Usage: curl -fsSL https://@@DOMAIN@@/stash/upload__CHANNEL__ | bash -s -- FILE
set -Eeuo pipefail
command -v python3 >/dev/null || { echo 'Python 3.9+ is required.' >&2; exit 1; }
python3 - "$@" <<'LINSPACE_STASH_PY'
@@include:src/stash/client.py@@
main('https://@@DOMAIN@@', 'upload__CHANNEL__')
LINSPACE_STASH_PY
