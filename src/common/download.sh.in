# Verified downloads shared by the generated installers (Bash 3.2+).
linspace_checksum() {
    [[ -f $1 && ! -L $1 && $(wc -c < "$1") -eq $3 ]] || return 1
    local digest
    if command -v sha256sum >/dev/null 2>&1; then
        digest=$(sha256sum "$1") || return 1
    else
        digest=$(shasum -a 256 "$1") || return 1
    fi
    [[ ${digest%% *} == "$2" ]]
}

linspace_proxy_set() {
    [[ -n ${https_proxy:-}${HTTPS_PROXY:-}${all_proxy:-}${ALL_PROXY:-} ]]
}

linspace_fetch() {
    local url=$1 target=$2 limit=$3 mode=$4 budget=$5
    local proxy=(--noproxy "${no_proxy:-${NO_PROXY:-}}") progress=(-sS)
    [[ $mode != direct ]] || proxy=(--noproxy '*' --proxy '')
    [[ ! -t 2 ]] || progress=(--progress-bar --show-error)
    curl -q -fL "${progress[@]}" --globoff --proto '=https' --proto-redir '=https' \
        "${proxy[@]}" --connect-timeout 5 --max-time "$budget" --retry 0 \
        --speed-limit 131072 --speed-time 10 --max-filesize "$limit" "$url" -o "$target"
}

linspace_file() (
    set -uo pipefail
    sha=$1 size=$2 url=$3 first=$4 budget=$5
    cache=${LINSPACE_DOWNLOAD_CACHE:?Missing download cache}
    [[ ! -L $cache ]] || return 1
    umask 077
    mkdir -p -- "$cache" || return 1
    [[ -O $cache ]] || return 1
    chmod 700 "$cache" || return 1
    cached=$cache/$sha
    linspace_checksum "$cached" "$sha" "$size" && return 0
    [[ ! -e $cached || -f $cached ]] || return 1
    temporary=$(mktemp "$cache/.download.XXXXXX") || return 1
    trap 'rm -f -- "$temporary" "$temporary.err"' EXIT
    modes=("$first")
    if linspace_proxy_set; then
        if [[ $first == direct ]]; then modes+=(environment); else modes+=(direct); fi
    fi
    for mode in "${modes[@]}"; do
        host=${url#*://}; host=${host%%/*}
        route=direct
        if [[ $mode == environment ]] && linspace_proxy_set; then route=proxy; fi
        linspace_log STEP "Download ${LINSPACE_DOWNLOAD_LABEL:-file} from $host ($route)"
        if linspace_fetch "$url" "$temporary" "$size" "$mode" "$budget" 2>"$temporary.err" && linspace_checksum "$temporary" "$sha" "$size"; then
            mv -f -- "$temporary" "$cached" || return 1
            return 0
        fi
        linspace_log WARN "Source failed or checksum mismatch: $host"
        : > "$temporary" || return 1
    done
    return 1
)

linspace_asset_info() {
    case "$1" in
@@ASSET_CASES@@
        *) linspace_log ERROR "Unknown installation asset: $1"; return 1 ;;
    esac
}

linspace_asset() (
    set -uo pipefail
    name=$1 target=$2
    LINSPACE_DOWNLOAD_LABEL=$name
    linspace_asset_info "$name" || return 1
    cache=${LINSPACE_DOWNLOAD_CACHE:?Missing download cache}
    [[ $cache == /* && ! -L $cache ]] || return 1
    umask 077
    mkdir -p -- "$cache" || return 1
    [[ -O $cache ]] || return 1
    chmod 700 "$cache" || return 1
    if linspace_checksum "$cache/$ASSET_SHA" "$ASSET_SHA" "$ASSET_SIZE"; then
        cp -- "$cache/$ASSET_SHA" "$target"
        return $?
    fi
    # Each source is bounded. A configured but broken proxy is retried directly.
    if [[ -n $ASSET_URL ]] && linspace_file "$ASSET_SHA" "$ASSET_SIZE" "$ASSET_URL" environment 90; then
        cp -- "$cache/$ASSET_SHA" "$target"
        return $?
    fi
    linspace_log WARN "Using download fallback for $name"
    joined=$(mktemp "$cache/.assemble.XXXXXX") || return 1
    trap 'rm -f -- "$joined"' EXIT
    for ((index=0; index<${#ASSET_PART_URLS[@]}; index++)); do
        LINSPACE_DOWNLOAD_LABEL="$name [$((index+1))/${#ASSET_PART_URLS[@]}]"
        sha=${ASSET_PART_SHAS[index]}
        linspace_file "$sha" "${ASSET_PART_SIZES[index]}" "${ASSET_PART_URLS[index]}" direct 600 || return 1
        cat -- "$cache/$sha" >> "$joined" || return 1
    done
    linspace_checksum "$joined" "$ASSET_SHA" "$ASSET_SIZE" || { linspace_log ERROR 'Asset checksum mismatch.'; return 1; }
    mv -f -- "$joined" "$cache/$ASSET_SHA" || return 1
    cp -- "$cache/$ASSET_SHA" "$target"
)

linspace_platform() {
    local os arch
    case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) linspace_log ERROR 'Linux or macOS is required.'; return 1 ;; esac
    case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) linspace_log ERROR 'x86_64 or ARM64 is required.'; return 1 ;; esac
    printf '%s-%s\n' "$os" "$arch"
}

linspace_python_runtime() (
    set -Eeuo pipefail
    platform=$1 minimum=$2
    linspace_asset_info "python-$platform" 2>/dev/null || { linspace_log ERROR "Python 3.$minimum+ is required on $platform."; exit 1; }
    cache=${LINSPACE_DOWNLOAD_CACHE:?Missing download cache}
    [[ $cache == /* && ! -L $cache ]] || exit 1
    umask 077
    mkdir -p -- "$cache"
    [[ -O $cache ]] || exit 1
    chmod 700 "$cache"
    runtime=$cache/python-$ASSET_SHA
    [[ ! -L $runtime && ( ! -e $runtime || -d $runtime ) ]] || exit 1
    usable() { [[ -x $1/python/bin/python3 ]] && "$1/python/bin/python3" -I -c "import ssl,sys; assert sys.version_info >= (3,$minimum)" >/dev/null 2>&1; }
    if usable "$runtime"; then printf '%s\n' "$runtime/python/bin/python3"; exit 0; fi
    lock=$cache/.python-lock-$ASSET_SHA
    locked=0
    for ((attempt=0; attempt<30; attempt++)); do
        if mkdir -- "$lock" 2>/dev/null; then locked=1; break; fi
        [[ -d $lock && ! -L $lock ]] || exit 1
        owner=''
        if [[ -f $lock/pid ]]; then
            IFS= read -r owner < "$lock/pid" || true
            if [[ $owner =~ ^[0-9]+$ ]] && ! kill -0 "$owner" 2>/dev/null; then
                rm -f -- "$lock/pid"
                rmdir -- "$lock" 2>/dev/null || true
            fi
        fi
        sleep 1
    done
    [[ $locked == 1 ]] || { linspace_log ERROR 'Another installer is preparing Python; retry shortly.'; exit 1; }
    staged='' previous='' installed=0 ready=0
    cleanup() {
        result=$?
        trap - EXIT
        [[ -z $staged ]] || rm -rf -- "$staged"
        if [[ $ready == 0 && $installed == 1 ]]; then rm -rf -- "$runtime"; fi
        if [[ -n $previous && -d $previous ]]; then
            if [[ $ready == 1 ]]; then
                rm -rf -- "$previous"
            else
                mv -- "$previous" "$runtime"
            fi
        fi
        rm -f -- "$lock/pid"
        rmdir -- "$lock" 2>/dev/null || true
        exit "$result"
    }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    printf '%s\n' "${BASHPID:-$$}" > "$lock/pid"
    if usable "$runtime"; then printf '%s\n' "$runtime/python/bin/python3"; exit 0; fi
    staged=$(mktemp -d "$cache/.python.XXXXXX")
    linspace_asset "python-$platform" "$staged/runtime.tar.gz" || exit 1
    tar -xzf "$staged/runtime.tar.gz" -C "$staged"
    rm -- "$staged/runtime.tar.gz"
    usable "$staged" || { linspace_log ERROR 'The downloaded Python runtime cannot run on this system.'; exit 1; }
    # Another installer may have completed while the archive was downloading.
    if ! usable "$runtime"; then
        if [[ -e $runtime ]]; then
            previous=$(mktemp -d "$cache/.python-previous.XXXXXX")
            rmdir "$previous"
            mv -- "$runtime" "$previous"
        fi
        mv -- "$staged" "$runtime"
        installed=1
    fi
    usable "$runtime" || exit 1
    ready=1
    printf '%s\n' "$runtime/python/bin/python3"
)

linspace_python() {
    local minimum=${1:-9} platform
    if command -v python3 >/dev/null 2>&1 && python3 -I -c "import sys; assert sys.version_info >= (3,$minimum)" 2>/dev/null; then
        LINSPACE_PYTHON=$(command -v python3)
        return 0
    fi
    platform=$(linspace_platform) || return 1
    LINSPACE_PYTHON=$(linspace_python_runtime "$platform" "$minimum")
}
