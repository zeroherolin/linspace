#!/usr/bin/env bash
# Install @@CLIENT_NAME@@, with a verified download fallback.
main() (
    set -Eeuo pipefail
    umask 077
    CLIENT=@@CLIENT@@
@@include:src/common/ui.sh@@
    fail() { linspace_log ERROR "$*"; exit 1; }
    [[ ${1:-} != -h && ${1:-} != --help ]] || { printf 'Usage: curl -fsSL https://@@DOMAIN@@/%s/install | bash\n' "$CLIENT"; exit 0; }
    [[ $# == 0 ]] || { printf 'Usage: curl -fsSL https://@@DOMAIN@@/%s/install | bash\n' "$CLIENT"; exit 1; }
    [[ -z ${SUDO_USER:-} || ${SUDO_USER:-} == root ]] || fail 'Run as the account that will use this client, without sudo.'
    for command in curl tar gzip mktemp diff; do command -v "$command" >/dev/null || fail "Missing prerequisite: $command"; done
    command -v sha256sum >/dev/null || command -v shasum >/dev/null || fail 'A SHA256 tool is required.'
    [[ ${HOME:-} == /* ]] || fail 'HOME must be an absolute directory.'
    data=${XDG_DATA_HOME:-$HOME/.local/share}/linspace/$CLIENT
    bin=$HOME/.local/bin
    [[ $CLIENT != codex || -z ${CODEX_INSTALL_DIR:-} ]] || bin=$CODEX_INSTALL_DIR
    [[ $data == /* && $bin == /* && $bin != *:* && ! $bin =~ [[:cntrl:]] && ! $data =~ [[:cntrl:]] && ! -L $data && ! -L $bin ]] || fail 'Use absolute installation paths without symbolic-link directories.'
    LINSPACE_DOWNLOAD_CACHE=${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/linspace
    [[ $LINSPACE_DOWNLOAD_CACHE == /* && ! -L $LINSPACE_DOWNLOAD_CACHE ]] || fail 'Use an absolute, private cache directory.'
    mkdir -p -- "$LINSPACE_DOWNLOAD_CACHE"
    [[ -O $LINSPACE_DOWNLOAD_CACHE ]] || fail 'The cache must belong to the current account.'
    chmod 700 "$LINSPACE_DOWNLOAD_CACHE"
    WORK=$(mktemp -d "$LINSPACE_DOWNLOAD_CACHE/.install.XXXXXX")
    stage='' pending='' new_release='' backup='' activated=0
    cleanup() {
        status=$?
        trap - EXIT
        rm -rf -- "$WORK"
        [[ -z $stage ]] || rm -rf -- "$stage"
        [[ -z $pending ]] || rm -rf -- "$pending"
        if [[ $activated == 0 ]]; then
            [[ -z $new_release ]] || rm -rf -- "$new_release"
            [[ -z $backup ]] || rm -rf -- "$backup"
        fi
        exit "$status"
    }
    trap cleanup EXIT
    trap 'status=$?; linspace_log ERROR "Installation failed (exit $status)."; exit "$status"' ERR
    trap 'exit 130' INT
    trap 'exit 143' TERM
@@include:src/common/download.sh.in@@
    platform=$(linspace_platform) || exit 1
    # A separate process group lets the time limit also stop child downloads.
    bounded() (
        trap - ERR
        set +e
        budget=$1; shift
        set -m
        "$@" </dev/null & worker=$!
        (sleep "$budget"; kill -TERM -- "-$worker" 2>/dev/null; sleep 2; kill -KILL -- "-$worker" 2>/dev/null) & watchdog=$!
        set +m
        trap 'kill -KILL -- "-$worker" "-$watchdog" 2>/dev/null; wait "$worker" "$watchdog" 2>/dev/null' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        wait "$worker"; result=$?
        # Clean up any surviving downloader even after the installer's shell exits.
        kill -KILL -- "-$worker" 2>/dev/null
        kill -TERM -- "-$watchdog" 2>/dev/null
        wait "$watchdog" 2>/dev/null
        exit "$result"
    )
    linspace_asset_info "$CLIENT-$platform" 2>/dev/null || fail "No verified package is available for $platform."
    linspace_log STEP "Install $CLIENT $ASSET_VERSION ($platform)"
    version=$ASSET_VERSION
    digest=$ASSET_SHA
    # Do not downgrade a newer, functioning client when the network is unavailable.
    newer_than_pinned() {
        local output=$1 a b c x y z
        [[ $output =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
        a=${BASH_REMATCH[1]}; b=${BASH_REMATCH[2]}; c=${BASH_REMATCH[3]}
        [[ $version =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]] || return 1
        x=${BASH_REMATCH[1]}; y=${BASH_REMATCH[2]}; z=${BASH_REMATCH[3]}
        (( 10#$a > 10#$x || 10#$a == 10#$x && (10#$b > 10#$y || 10#$b == 10#$y && 10#$c > 10#$z) ))
    }
    if [[ -x $bin/$CLIENT && ! -d $bin/$CLIENT ]] && bounded 15 "$bin/$CLIENT" --version > "$WORK/existing-version" 2>/dev/null && newer_than_pinned "$(cat "$WORK/existing-version")"; then
        linspace_log OK "Keeping newer $CLIENT: $(cat "$WORK/existing-version")"
        linspace_path_hint "$CLIENT" "$bin"
        exit 0
    fi
    linspace_asset "$CLIENT-$platform" "$WORK/client.tar.gz" || fail 'All download attempts failed. Rerun this command to reuse verified downloads.'
    # Extract into a fresh directory; never extract over user configuration or an existing install.
    mkdir "$WORK/package"
    tar -xzf "$WORK/client.tar.gz" -C "$WORK/package"
    if [[ $CLIENT == codex ]]; then
        cat > "$WORK/package/LICENSE.Codex" <<'CODEX_LICENSE'
@@include:vendor/notices/LICENSE.Codex@@
CODEX_LICENSE
        cat > "$WORK/package/NOTICE.Codex" <<'CODEX_NOTICE'
@@include:vendor/notices/NOTICE.Codex@@
CODEX_NOTICE
        cat > "$WORK/package/LICENSE.bubblewrap" <<'BWRAP_LICENSE'
@@include:vendor/notices/LICENSE.bubblewrap@@
BWRAP_LICENSE
        for file in bin/codex bin/codex-code-mode-host codex-path/rg; do
            [[ -f $WORK/package/$file && ! -L $WORK/package/$file ]] || fail "The package is incomplete: $file"
            chmod 755 "$WORK/package/$file"
        done
        if [[ $platform == linux-* ]]; then
            [[ -f $WORK/package/codex-resources/bwrap ]] || fail 'The Codex sandbox helper is missing.'
            chmod 755 "$WORK/package/codex-resources/bwrap"
        fi
        executable=bin/codex
        ln -s bin/codex "$WORK/package/codex"
    else
        executable=package/claude
        [[ -f $WORK/package/$executable && ! -L $WORK/package/$executable ]] || fail 'The Claude native executable is missing.'
        chmod 755 "$WORK/package/$executable"
    fi
    if ! bounded 15 "$WORK/package/$executable" --version > "$WORK/version" 2> "$WORK/version.err"; then
        while IFS= read -r line; do linspace_log ERROR "$line"; done < "$WORK/version.err"
        fail 'This package cannot run on this system.'
    fi
    if [[ -s $WORK/version.err ]]; then
        while IFS= read -r line; do linspace_log WARN "$line"; done < "$WORK/version.err"
    fi
    [[ $(cat "$WORK/version") == *"$version"* ]] || fail 'The installed version did not match the pinned package.'
    mkdir -p -- "$data" "$bin"
    [[ -O $data && -O $bin ]] || fail 'Installation directories must belong to the current account.'
    release=$data/$version-$platform-$digest
    [[ ! -L $release ]] || fail 'The version directory must not be a symbolic link.'
    if [[ -e $release ]] && ! diff -qr "$WORK/package" "$release" >/dev/null; then
        release=$(mktemp -d "$data/$version-$platform-repair.XXXXXX")
        rmdir "$release"
    fi
    # Keep a complete immutable version directory. A failed download never replaces the visible command.
    if [[ ! -e $release ]]; then
        stage=$(mktemp -d "$data/.stage.XXXXXX")
        cp -R "$WORK/package/." "$stage/" || { rm -rf -- "$stage"; fail 'Could not stage the installation.'; }
        mv -- "$stage" "$release"
        new_release=$release
    fi
    [[ ! -L $release && -x $release/$executable ]] || fail 'The existing version directory is invalid.'
    link=$bin/$CLIENT
    [[ ! -d $link && ( ! -e $link || -f $link || -L $link ) ]] || fail 'The command path is not a file.'
    if [[ ! -L $link || $(readlink "$link") != "$release/$executable" ]]; then
        if [[ -e $link || -L $link ]]; then
            backup=$(mktemp -d "$data/.previous.XXXXXX")
            cp -P -- "$link" "$backup/$CLIENT"
            linspace_log INFO "Previous launcher: $backup/$CLIENT"
        fi
        ln -s "$release/$executable" "$WORK/launcher"
        # Stage the symlink on the target filesystem before an atomic rename.
        pending=$(mktemp -d "$bin/.linspace.XXXXXX")
        mv -- "$WORK/launcher" "$pending/$CLIENT"
        mv -f -- "$pending/$CLIENT" "$link"
        activated=1
        rmdir "$pending"
    fi
    activated=1
    linspace_log OK "Installed $CLIENT $version at $link"
    linspace_path_hint "$CLIENT" "$bin"
    linspace_log INFO 'Rerun after site updates to install a newer reviewed version.'
)
main "$@"
