#!/usr/bin/env bash
@@include:src/common/ui.sh@@
# Usage: curl -fsSL https://@@PAGE_DOMAIN@@/NAME/__ACTION__ | bash__USAGE__
main() (
set -Eeuo pipefail
@@include:src/common/download.sh.in@@
LINSPACE_DOWNLOAD_CACHE=${XDG_CACHE_HOME:-${HOME:?HOME is required}/.cache}/linspace
linspace_python 9 || { linspace_log ERROR 'Could not prepare Python.'; exit 1; }
"$LINSPACE_PYTHON" -I - "$@" <<'LINSPACE_STASH_PY'
@@include:src/stash/client.py@@
# The page host fills in NAME from the address this script was downloaded from.
main('https://@@DOMAIN@@', 'page-__ACTION__', page='[[linspace: placeholder "http.regexp.page.1" ]]', page_url='https://@@PAGE_DOMAIN@@')
LINSPACE_STASH_PY
)
main "$@"
